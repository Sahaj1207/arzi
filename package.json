{
  "name": "arzi",
  "version": "0.1.0",
  "private": true,
  "description": "Arzi: speak your legal problem, get a lawyer-verified document.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server/src/index.js",
    "test": "node --test \"shared/test/*.test.js\" \"client/test/*.test.js\" \"server/test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}

# Arzi configuration. EVERY value here is optional.
# With no .env at all, Arzi runs in Demo mode with browser speech.
# Copy to .env and fill in only what you have. Keys are read by the backend only
# and are never sent to the browser.

# --- AI mode (optional upgrade) ---
# Sarvam AI (https://docs.sarvam.ai). Used only after the citizen agrees, once per session.
#   speech-to-text  saaras:v4      (falls back to browser speech on any error / no credits)
#   voice           bulbul:v3      (only when the browser has no voice for the language)
#   understanding   sarvam-105b-conversations  (reads answers the built-in parser cannot)
#   transliteration Hindi/Marathi/Telugu names → English letters in the English notice
SARVAM_API_KEY=
# Optional Sarvam voice for read-back (bulbul:v3 speaker name, default priya).
SARVAM_TTS_SPEAKER=

# Not wired up yet (planned): Wispr Flow (approval-only access) and Anthropic.
WISPR_API_KEY=
ANTHROPIC_API_KEY=

# --- Advocate page ---
# PIN for /advocate. Default is 1234 when not set.
ADVOCATE_PIN=
# Name printed on notices as "Reviewed by Advocate <name>".
ADVOCATE_NAME=

# --- Limits for paid API calls (per anonymous user and per IP, per day) ---
PAID_CALLS_PER_USER_PER_DAY=150
PAID_CALLS_PER_IP_PER_DAY=500

# --- Server ---
PORT=3000
# Where the SQLite DB, recordings and PDFs are stored.
DATA_DIR=./data
# Path to Chrome/Chromium for PDF generation (auto-detected if empty).
CHROMIUM_PATH=
# auto (default: Chromium if found) | chromium | print (always the browser
# print-to-PDF page; used on the Render free tier, which is too slow for Chromium).
PDF_ENGINE=

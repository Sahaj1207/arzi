# Arzi configuration. EVERY value here is optional.
# With no .env at all, Arzi runs in Demo mode with browser speech.
# Copy to .env and fill in only what you have. Keys are read by the backend only
# and are never sent to the browser.

# --- Speech, voice and AI drafting (optional upgrades) ---
# Sarvam AI (https://docs.sarvam.ai): speech-to-text, text-to-speech and LLM drafting.
SARVAM_API_KEY=

# Wispr Flow Voice Interface API (approval-only access). Adapter is untested.
WISPR_API_KEY=

# Anthropic (Claude) for AI-mode drafting.
ANTHROPIC_API_KEY=

# --- Advocate page ---
# PIN for /advocate. Default is 1234 when not set.
ADVOCATE_PIN=
# Name printed on notices as "Reviewed by Advocate <name>".
ADVOCATE_NAME=

# --- Limits for paid API calls (per anonymous user and per IP, per day) ---
PAID_CALLS_PER_USER_PER_DAY=40
PAID_CALLS_PER_IP_PER_DAY=120

# --- Server ---
PORT=3000
# Where the SQLite DB, recordings and PDFs are stored.
DATA_DIR=./data
# Path to Chrome/Chromium for PDF generation (auto-detected if empty).
CHROMIUM_PATH=
